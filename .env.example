SANDBOX_KIT_DATA_DIR=./data
SANDBOX_KIT_INLINE_MAX_BYTES=3145728        # ~3MB: ngưỡng file lớn đi đường upload riêng
SANDBOX_KIT_BLOB_SIDECAR_MIN_BYTES=33554432 # 32MB: ngưỡng lưu thành file rời
SANDBOX_KIT_WORKSPACE_QUOTA_BYTES=2147483648 # 2GB hard quota per workspace
SANDBOX_KIT_POLICY_MODE=audit                # audit | enforce
SANDBOX_KIT_STAGING_MAX_AGE_HOURS=24
SANDBOX_KIT_HOST=127.0.0.1
SANDBOX_KIT_PORT=8000
SANDBOX_KIT_API_KEY=                        # trống = no-auth
SANDBOX_KIT_PROVIDER=fake                    # fake | docker
SANDBOX_KIT_SANDBOX_IMAGE=sandbox-kit/sandbox:w2  # make image
SANDBOX_KIT_SANDBOX_NETWORK=true             # false → container không ra mạng
SANDBOX_KIT_FAKE_EXEC_HOST=false             # fake: true → chạy lệnh THẬT trên host (không cô lập!)
SANDBOX_KIT_COMMAND_TIMEOUT_DEFAULT=120      # giây
SANDBOX_KIT_COMMAND_TIMEOUT_MAX=600
SANDBOX_KIT_COMMAND_OUTPUT_MAX_BYTES=1048576 # mỗi luồng, giữ phần cuối
SANDBOX_KIT_AGENT_READY_TIMEOUT=90
